# PatchPilot Environment Configuration Example
# Copy this file to .env.local for local overrides.
# DO NOT commit .env.local or real secrets to version control.

# Application Environment
NODE_ENV=development
PORT=3000

# GitHub Integration (Optional for Stage 1-2; used for higher rate limits in Stage 3+)
# Never provide real tokens here.
GITHUB_TOKEN=your_github_personal_access_token_placeholder

# LLM Provider Configuration (Stage 5)
# Supported provider: mock | gemini
AI_PROVIDER=mock

# Google Gemini Configuration (when AI_PROVIDER=gemini)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-3.8-flash
